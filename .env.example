BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
OWNER_CHAT_ID=123456789
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/jobhunter

# === HeadHunter ===
HH_ACCESS_TOKEN=your_hh_oauth_access_token
HH_RESUME_ID=your_32_char_resume_hash_id

# === SuperJob (опционально) ===
# SUPERJOB_SECRET_KEY=your_superjob_secret_key
# SUPERJOB_ACCESS_TOKEN=your_superjob_access_token
# SUPERJOB_RESUME_ID=12345

# === Включение/выключение площадок ===
ENABLE_HH=true
ENABLE_ZARPLATA=true
ENABLE_SUPERJOB=false
ENABLE_HABR=false
ENABLE_AVITO=false
ENABLE_FREELANCE_RU=false
ENABLE_WORKZILLA=false

# === Стартовые фильтры ===
SEARCH_QUERY=Удаленно OR Оператор OR Менеджер
REMOTE_ONLY=true
POLL_INTERVAL_SECONDS=300
DEFAULT_COVER_LETTER=Здравствуйте! Заинтересовала ваша вакансия. Буду рад обсудить детали.